generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    email    String @unique
    password String

    name   String
    avatar String?

    status UserStatus @default(ACTIVE)

    apiKeys ApiKey[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}

model ApiKey {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    name String

    key    String  @unique
    active Boolean @default(true)

    providerSelections ProviderSelection[]
    lastErrors         LastError[]

    user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String? @db.ObjectId

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("api_keys")
}

model LastError {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    apiKeyId String @db.ObjectId
    apiKey   ApiKey @relation(fields: [apiKeyId], references: [id])

    modelId String         @db.ObjectId
    model   ModelSelection @relation(fields: [modelId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("last_errors")
}

model Provider {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    name        String
    description String?

    baseApi String

    free Boolean   @default(false)
    type ModelType @default(OPENAI)

    status ModelStatus @default(ACTIVE)

    model Model?

    providerSelectionIds String[]            @db.ObjectId
    providerSelections   ProviderSelection[] @relation("ProviderSelectionProviders", fields: [providerSelectionIds], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("providers")
}

model Model {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    providerId String   @unique @db.ObjectId
    provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

    name               String
    code               String
    maxTokens          Int?
    tokenResetInterval Int? // In Minutes

    efficiencyScore Float? // 0.0 - 1.0, where 1.0 is most efficient

    status ModelStatus @default(ACTIVE)

    modelSelectionIds String[]         @db.ObjectId
    modelSelections   ModelSelection[] @relation("ModelSelectionModels", fields: [modelSelectionIds], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("models")
}

model UserProvider {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    name        String
    description String?

    baseApi String

    free Boolean   @default(false)
    type ModelType

    status ModelStatus @default(ACTIVE)

    model UserModel?

    providerSelectionIds String[]            @db.ObjectId
    providerSelections   ProviderSelection[] @relation("ProviderSelectionUserProviders", fields: [providerSelectionIds], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("user__providers")
}

model UserModel {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    providerId String       @unique @db.ObjectId
    provider   UserProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

    usedTokens Int     @default(0)
    active     Boolean @default(true)

    modelSelectionIds String[]         @db.ObjectId
    modelSelections   ModelSelection[] @relation("ModelSelectionUserModels", fields: [modelSelectionIds], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("user__models")
}

model ProviderSelection {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    apiKeyId String @db.ObjectId
    apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

    providerIds String[]   @db.ObjectId
    providers   Provider[] @relation("ProviderSelectionProviders", fields: [providerIds], references: [id])

    userProviderIds String[]       @db.ObjectId
    userProviders   UserProvider[] @relation("ProviderSelectionUserProviders", fields: [userProviderIds], references: [id])

    modelSelectionIds String[]         @db.ObjectId
    modelSelections   ModelSelection[] @relation("ProviderSelectionModelSelections", fields: [modelSelectionIds], references: [id])

    active Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("user__provider_selections")
}

model ModelSelection {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    providerSelectionIds String[]            @db.ObjectId
    providerSelections   ProviderSelection[] @relation("ProviderSelectionModelSelections", fields: [providerSelectionIds], references: [id])

    modelIds String[] @db.ObjectId
    models   Model[]  @relation("ModelSelectionModels", fields: [modelIds], references: [id])

    userModelIds String[]    @db.ObjectId
    userModels   UserModel[] @relation("ModelSelectionUserModels", fields: [userModelIds], references: [id])

    lastErrors LastError[]

    usedTokens Int     @default(0)
    active     Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("user__model_selections")
}

// ENUMs
enum UserStatus {
    ACTIVE
    INACTIVE
    BANNED
    PENDING
}

enum ModelStatus {
    ACTIVE
    INACTIVE
    DEPRECATED
    TESTING
    UPCOMING
}

enum ModelType {
    OPENAI
    ANTHROPIC
    GEMINI
    CUSTOM
}
