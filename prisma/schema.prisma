generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    email    String @unique
    password String

    name   String
    avatar String?

    status UserStatus @default(ACTIVE)
    role   UserRole   @default(USER)

    apiKeys            ApiKey[]
    userProviders      UserProvider[]
    userModels         UserModel[]
    providerSelections ProviderSelection[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}

model ApiKey {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    name String

    key    String  @unique
    active Boolean @default(true)

    maxIterations  Int            @default(3)
    roundhouseMethod RoundhouseMethod @default(EFFICIENCY)

    providerSelections ProviderSelection[]
    lastErrors         LastError[]

    user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String? @db.ObjectId

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("api_keys")
}

model LastError {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    apiKeyId String @db.ObjectId
    apiKey   ApiKey @relation(fields: [apiKeyId], references: [id])

    modelId String

    providerApiKeyId String         @db.ObjectId
    providerApiKey   ProviderApiKey @relation(fields: [providerApiKeyId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("last_errors")
}

model Provider {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    name        String
    code        String  @unique
    description String?

    baseApi String

    free Boolean      @default(false)
    type ProviderType @default(OPENAI)

    status ContentStatus @default(ACTIVE)

    providerSelections ProviderSelection[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("providers")
}

model Model {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    name               String
    code               String
    maxTokens          Int?
    tokenResetInterval Int?
    provider           String

    efficiencyScore Float?
    bestFor         String[]
    thinking        Boolean  @default(false)

    status ContentStatus @default(ACTIVE)

    modelSelections ModelSelection[] @relation("ModelSelections")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([code, provider])
    @@map("models")
}

model UserProvider {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    name        String
    code        String
    description String?

    baseApi String

    free Boolean      @default(false)
    type ProviderType @default(CUSTOM)

    status ContentStatus @default(ACTIVE)

    providerSelections ProviderSelection[]

    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, code])
    @@map("user__providers")
}

model UserModel {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    name               String
    code               String
    maxTokens          Int?
    tokenResetInterval Int?
    provider           String

    efficiencyScore Float?
    bestFor         String[]
    thinking        Boolean  @default(false)

    status ContentStatus @default(ACTIVE)

    modelSelections ModelSelection[] @relation("UserModelSelections")

    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([code, provider, userId])
    @@map("user__models")
}

model ProviderSelection {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    apiKeyId String @db.ObjectId
    apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

    providerId String?   @db.ObjectId
    provider   Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

    userProviderId String?       @db.ObjectId
    userProvider   UserProvider? @relation(fields: [userProviderId], references: [id], onDelete: Cascade)

    modelSelections ModelSelection[]

    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    providerApiKeys ProviderApiKey[]

    active Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("user__provider_selections")
}

model ProviderApiKey {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    providerSelectionId String            @db.ObjectId
    providerSelection   ProviderSelection @relation(fields: [providerSelectionId], references: [id], onDelete: Cascade)

    key String

    active       Boolean @default(true)
    successCount Int     @default(0)

    lastErrors LastError[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([providerSelectionId, key])
    @@map("provider_api_keys")
}

model ModelSelection {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    providerSelectionId String            @db.ObjectId
    providerSelection   ProviderSelection @relation(fields: [providerSelectionId], references: [id], onDelete: Cascade)

    modelId String? @db.ObjectId
    model   Model?  @relation("ModelSelections", fields: [modelId], references: [id], onDelete: Cascade)

    userModelId String?    @db.ObjectId
    userModel   UserModel? @relation("UserModelSelections", fields: [userModelId], references: [id], onDelete: Cascade)

    // Statistics
    tokenUsage   Int       @default(0)
    successCount Int       @default(0)
    failureCount Int       @default(0)
    lastUsedAt   DateTime?

    active Boolean @default(true)
    priority Int @default(1)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([providerSelectionId, modelId, userModelId])
    @@map("model_selections")
}

enum UserStatus {
    ACTIVE
    INACTIVE
    BANNED
    PENDING
}

enum UserRole {
    USER
    ADMIN
}

enum ContentStatus {
    ACTIVE
    INACTIVE
    DEPRECATED
    TESTING
    UPCOMING
}

enum ProviderType {
    OPENAI
    ANTHROPIC
    GEMINI
    CUSTOM
}

enum RoundhouseMethod {
    RANDOM
    EFFICIENCY
}
