{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "rootDir": "src",
        "outDir": "dist",
        "baseUrl": "./",
        "paths": {
            "@/*": ["src/*"],
            "@lib/*": ["src/lib/*"],
            "@models/*": ["src/models/*"],
            "@modules/*": ["src/modules/*"]
        },
        // "moduleResolution": "Node",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["dist", "node_modules"]
}
